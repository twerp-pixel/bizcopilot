# Copy this file to .env and fill in your key(s). Never commit .env.

# Which provider to use: "anthropic" (default) or "gemini"
LLM_PROVIDER=anthropic

# --- Anthropic (used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your-key-here

# --- Gemini (used if LLM_PROVIDER=gemini) ---
# Get this from https://aistudio.google.com/ - NOT the same as a Gemini
# Advanced/consumer subscription, that doesn't give you API access on its own.
GEMINI_API_KEY=your-key-here

# Optional: override the model. Defaults per provider if left unset:
#   anthropic -> claude-sonnet-4-6
#   gemini    -> gemini-2.5-flash
# IMPORTANT: leave this line commented out (or delete it) to use the default -
# an empty value here is NOT the same as unset and will break both providers.
# BIZCOPILOT_MODEL=gemini-2.5-flash
