# Copy to .env and fill only the key for your selected provider.
# Never commit .env or share API keys.
# Supported: anthropic, gemini, groq
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=your-key-here

# Gemini
# GEMINI_API_KEY=your-key-here

# Groq
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=openai/gpt-oss-20b

# Optional model override for Anthropic or Gemini:
# BIZCOPILOT_MODEL=claude-sonnet-4-6
# BIZCOPILOT_MODEL=gemini-2.5-flash
